@{
    ViewBag.Title = "Action Result Demo";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-5">
    <div class="card shadow p-4 text-center">

        <h2 class="mb-4">Action Result Demo</h2>

        <div class="row g-3">

            <!-- Content-Result -->
            <div class="col-md-4">
                <a href="/ActionResultsDemo/GetText" class="btn btn-outline-primary w-100">
                    Content Result
                </a>
            </div>

            <!-- Json-Result -->
            <div class="col-md-4">
                <a href="/ActionResultsDemo/GetJsonData" class="btn btn-outline-primary w-100">
                    Json Result
                </a>
            </div>

            <!-- Empty-Result -->
            <div class="col-md-4">
                <a href="/ActionResultsDemo/DoNothing" class="btn btn-outline-primary w-100">
                    Empty Result
                </a>
            </div>

            <!-- File-Result -->
            <div class="col-md-4">
                <a href="/ActionResultsDemo/DownloadFile" class="btn btn-outline-primary w-100">
                    Download File
                </a>
            </div>

            <!-- Redirect-Result -->
            <div class="col-md-4">
                <a href="/ActionResultsDemo/RedirectToGoogle" class="btn btn-outline-primary w-100">
                    Redirect to Google
                </a>
            </div>

            <!-- RedirectToRoute-Result -->
            <div class="col-md-4">
                <a href="/ActionResultsDemo/RedirectToGetText" class="btn btn-outline-primary w-100">
                    Redirect To GetText
                </a>
            </div>

            <!-- JavaScript-Result -->
            <div class="col-md-4">
                <a href="/ActionResultsDemo/GetJavaScript" class="btn btn-outline-primary w-100">
                    JavaScript Result
                </a>
            </div>

            <!-- PartialView-Result -->
            <div class="col-md-4">
                <a href="/ActionResultsDemo/GetPartialView" class="btn btn-outline-primary w-100">
                    Partial View
                </a>
            </div>

        </div>

    </div>
</div>
